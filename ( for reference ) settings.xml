<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    
    <!-- Servers configuration for authenticated repositories -->
    <servers>
        <!-- Example for Maven Central (usually doesn't need auth) -->
        <server>
            <id>central</id>
            <username>your_username</username>
            <password>your_password</password>
        </server>
        
        <!-- Example for a private repository -->
        <server>
            <id>private-repo</id>
            <username>repo_username</username>
            <password>repo_password</password>
        </server>
    </servers>
	
	<mirrors>
        <mirror>
            <id>central-no-proxy</id>
			<mirrorOf>central</mirrorOf>
            <name>Central Repository without proxy</name>
            <url>https://repo.maven.apache.org/maven2</url>
			<blocked>false</blocked>
        </mirror>
    </mirrors>

    <!-- To use when outside corporate network -->
    <proxies>
		<proxy>
        <!-- Empty proxies section bypasses corporate proxy -->
          <id>example-proxy</id>
		  <active>true</active>
		  <protocol>http</protocol>
		  <host>corporate proxy rb-proxy-in.bosch.com</host>
		  <port>proxy-port 8080</port>
          <username>ntid</username>
          <password>laptop password</password>
		  <nonProxyHosts>www.google.com|*.example.com</nonProxyHosts>
		  </proxy>
    </proxies>
</settings> 